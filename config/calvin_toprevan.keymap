#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define OPTION 1

&sk {
    quick-release;
};

/ {
    macros {
        tmuxscroll: tmuxscroll {
          compatible = "zmk,behavior-macro";
          #binding-cells = <0>;
          bindings
              = <&macro_press &kp LCTL>
              , <&macro_tap &kp A>
              , <&macro_release &kp LCTL>
              , <&macro_tap &kp PG_UP>
              ;
        };
        macshot: macshot {
          compatible = "zmk,behavior-macro";
          #binding-cells = <0>;
          bindings
              = <&macro_press &kp LSFT>
              , <&macro_press &kp LGUI>
              , <&macro_tap &kp N4>
              , <&macro_release &kp LSFT>
              , <&macro_release &kp LGUI>
              ;
        };
        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_param_2to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_2to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                ;
        };
    };
    behaviors {
        lscaps: left_shift_capslock {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sk LSHFT>, <&caps_word>;
            mods = <(MOD_RSFT)>;
        };
        rscaps: right_shift_capslock {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sk RSHFT>, <&caps_word>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE   &kp Q        &kp W       &kp E       &kp R          &kp T        &kp Y            &kp U          &kp I       &kp O      &kp P              &kp BACKSPACE
&kp LGUI    &kp A        &kp S       &kp D       &kp F          &kp G        &kp H            &kp J          &kp K       &kp L      &kp QUOT           &kp RET
&lscaps     &kp Z        &kp X       &kp C       &kp V          &kp B        &kp N            &kp M          &kp COMMA   &kp DOT    &kp FSLH           &kp SEMI
&kp LALT    &lm OPTION LSHIFT        &mo OPTION                 &kp SPACE    &rscaps                         &kp TAB     &mo OPTION &lm OPTION RSHIFT  &kp RCTL
            >;
        };

        option {
            display-name = "Option";
            bindings = <
&kp ESC     &kp N1       &kp N2      &kp N3      &kp N4         &kp N5       &kp N6           &kp N7         &kp N8      &kp N9     &kp N0             &bootloader
&trans      &trans       &kp LBKT    &kp RBKT    &kp MINUS      &kp EQUAL    &kp LEFT         &kp DOWN       &kp UP      &kp RIGHT  &trans             &trans
&trans      &macshot     &tmuxscroll &trans      &trans         &trans       &trans           &trans         &trans      &trans     &kp BSLH           &trans
&trans      &trans                   &trans                     &trans       &trans                          &trans      &trans     &trans             &trans
            >;
        };
    };
};
